# Local development defaults. Do not put real Neon or JWT secrets in this file.
ENVIRONMENT=development
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Local SQLite. On Vercel set this to the Neon pooled URL (postgres:// or postgresql://).
# Do not use SQLite in production. If DATABASE_URL is missing there, the API reports it.
DATABASE_URL=sqlite:///./databoard.db

# Neon direct connection, used only by scripts/init_db.py and scripts/import_restaurant.py.
DATABASE_URL_UNPOOLED=

UPLOAD_DIR=./uploads
# Include the production frontend. Local origins are always added in code.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://cb-360-two.vercel.app
RESTAURANT_SOURCE_PATH=
REPORTS_DIR=

# Dataset uploads. local is for development. Production needs an S3-compatible bucket.
# Vercel /tmp is not permanent storage.
STORAGE_BACKEND=local
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
